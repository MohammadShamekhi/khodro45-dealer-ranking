# Copy to .env for local runs / docker run --env-file .env
# On PaaS (Darkube), set the same variables in the platform UI — no docker-compose.
#   set -a && source .env && set +a

# =========================
# Ranker strategy (switch between in-process models)
# =========================
RANKER_STRATEGY=identity

# =========================
# Redis (auction snapshot — written by an external service, read by this API)
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

AUCTION_CACHE_REDIS_KEY=auctions:live:snapshot
AUCTION_CACHE_META_KEY=auctions:live:meta
DEALER_EXTRACTIONS_REDIS_KEY_PREFIX=dealers_extractions

# =========================
# Dealer preferences (/api/v1/dealer_preferences/)
# =========================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

K45_HOST=127.0.0.1
K45_PORT=5432
K45_NAME=k45
K45_USER=postgres
K45_PASSWORD=

# =========================
# Server Config
# =========================
HOST=0.0.0.0
PORT=8080

# =========================
# Logging (JSON lines — one object per record)
# =========================
# LOG_FILE_PATH=/var/log/dealerintelligence/app.json
LOG_LEVEL=INFO
